---
import { profileConfig, siteConfig } from "../config";

const currentYear = new Date().getFullYear();
---

<div class="footer-divider"></div>

<footer class="footer-card">
	<div class="footer-glow footer-glow--peach"></div>
	<div class="footer-glow footer-glow--mint"></div>

	<div class="footer-inner">
		<div class="footer-main-row">
			<div class="footer-copy-block">
				<div class="footer-brand-row">
					<span class="footer-brand">{siteConfig.title}</span>
					<span class="footer-dot"></span>
					<span class="footer-year">{currentYear}</span>
				</div>
				<p class="footer-copyline">
					&copy; {currentYear} {profileConfig.name}.
					<span data-lang-zh="保留所有权利。" data-lang-en="All Rights Reserved.">
						All Rights Reserved.
					</span>
				</p>
			</div>

			<div class="footer-cat-zone" data-footer-cat-zone>
				<div class="footer-cat-toy" data-footer-cat-toy aria-hidden="true"></div>
				<button
					type="button"
					class="footer-cat"
					data-footer-cat
					aria-pressed="false"
					aria-label="Play with the footer cat"
					data-lang-aria-label-zh="点一下，逗逗页尾的小猫"
					data-lang-aria-label-en="Play with the footer cat"
				>
					<span class="footer-cat-figure" aria-hidden="true">
						<svg viewBox="0 0 120 56" class="footer-cat-svg" role="presentation">
							<g class="footer-cat-tail-group">
								<path class="footer-cat-line" d="M32 35C20 29 16 18 23 10C29 4 38 10 36 19C35 26 37 32 42 35" />
							</g>
							<path class="footer-cat-line" d="M39 35C42 24 53 18 67 18H73C82 18 89 23 92 31" />
							<path class="footer-cat-line" d="M39 35C52 40 73 41 92 35" />
							<path class="footer-cat-line" d="M88 30C86 34 83 35.5 78.5 35.8" />
							<path class="footer-cat-line footer-cat-leg is-back" d="M51 35L50 46Q50 48 52 48" />
							<path class="footer-cat-line footer-cat-leg is-back" d="M63 36L62 47Q62 49 64 49" />
							<path class="footer-cat-line footer-cat-leg is-front" d="M77 36L76 47Q76 49 78 49" />
							<path class="footer-cat-line footer-cat-leg is-front" d="M88 35L87 45Q87 47 89 47" />
							<circle class="footer-cat-line" cx="96" cy="20" r="10" />
							<path class="footer-cat-line" d="M88 13L92 5L96 13" />
							<path class="footer-cat-line" d="M97 13L101 5L104 13" />
							<circle class="footer-cat-eye" cx="92.5" cy="19.5" r="1.05" />
							<circle class="footer-cat-eye" cx="99" cy="19.5" r="1.05" />
							<path class="footer-cat-line" d="M95.2 24Q96 25.1 96.8 24" />
							<path class="footer-cat-whisker" d="M102 21.8L109.5 19.4" />
							<path class="footer-cat-whisker" d="M102.5 24.4L110.5 24.4" />
							<path class="footer-cat-whisker" d="M102 27L109.5 29.3" />
						</svg>
					</span>
				</button>
			</div>
		</div>
	</div>
</footer>

<style>
	.footer-divider {
		margin: 2.15rem auto 0.8rem;
		width: 100%;
		height: 1px;
		border-top: 1px dashed var(--line-divider);
		opacity: 0.5;
	}

	.footer-card {
		position: relative;
		isolation: isolate;
		overflow: visible;
		margin: 0 auto 2.25rem;
		width: 100%;
		border: none;
		border-radius: 0;
		background:
			linear-gradient(
				90deg,
				transparent 0%,
				color-mix(in srgb, var(--card-bg) 54%, transparent) 10%,
				color-mix(in srgb, var(--card-bg) 82%, transparent) 50%,
				color-mix(in srgb, var(--card-bg) 54%, transparent) 90%,
				transparent 100%
			);
		box-shadow: none;
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
	}

	.footer-card::before {
		content: "";
		position: absolute;
		inset: 0;
		border-top: 1px solid color-mix(in srgb, var(--line-divider) 42%, transparent);
		border-bottom: 1px solid color-mix(in srgb, var(--line-divider) 32%, transparent);
		background:
			linear-gradient(
				180deg,
				color-mix(in srgb, rgba(255, 255, 255, 0.42) 28%, transparent) 0%,
				transparent 46%,
				color-mix(in srgb, rgba(255, 255, 255, 0.18) 16%, transparent) 100%
			);
		pointer-events: none;
	}

	.footer-inner {
		position: relative;
		z-index: 1;
		padding: 0.82rem 0.65rem;
	}

	.footer-cat-zone {
		position: relative;
		flex: 1 1 14rem;
		align-self: center;
		min-width: clamp(10rem, 18vw, 14rem);
		max-width: 26rem;
		height: 3.7rem;
		margin-inline: clamp(0.25rem, 1vw, 0.9rem);
		padding: 0 0.2rem 0.28rem;
		overflow: hidden;
	}

	.footer-cat-toy {
		position: absolute;
		left: 0;
		bottom: 0.88rem;
		width: 0.78rem;
		height: 0.78rem;
		border-radius: 999px;
		border: 1px solid color-mix(in srgb, var(--line-divider) 80%, transparent);
		background:
			radial-gradient(circle at 35% 32%, rgba(255, 255, 255, 0.94), rgba(255, 255, 255, 0) 32%),
			linear-gradient(145deg, rgba(255, 214, 226, 0.88), rgba(170, 230, 219, 0.86));
		box-shadow: 0 10px 18px -12px rgba(40, 68, 71, 0.26);
		opacity: 0;
		pointer-events: none;
		transition:
			opacity 180ms ease,
			filter 180ms ease;
		filter: saturate(0.96);
	}

	.footer-cat-toy[data-visible="true"] {
		opacity: 1;
	}

	.footer-cat {
		position: absolute;
		left: 0;
		bottom: 0.16rem;
		width: clamp(4.15rem, 7vw, 4.9rem);
		padding: 0;
		border: none;
		background: none;
		color: color-mix(in srgb, var(--deep-text) 82%, white 8%);
		cursor: pointer;
		appearance: none;
		-webkit-appearance: none;
		transform-origin: center bottom;
		touch-action: manipulation;
	}

	.footer-cat:hover {
		filter: saturate(1.08);
	}

	.footer-cat-figure {
		display: block;
		transform: scaleX(var(--footer-cat-dir, 1));
		transform-origin: center bottom;
	}

	.footer-cat-svg {
		display: block;
		width: 100%;
		height: auto;
		overflow: visible;
		filter: drop-shadow(0 10px 16px rgba(28, 45, 49, 0.08));
	}

	.footer-cat-line,
	.footer-cat-whisker {
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		vector-effect: non-scaling-stroke;
	}

	.footer-cat-line {
		stroke-width: 2.5;
	}

	.footer-cat-whisker {
		stroke-width: 1.55;
		opacity: 0.9;
	}

	.footer-cat-eye {
		fill: currentColor;
	}

	.footer-cat[data-paused="true"] {
		filter: saturate(0.9);
	}

	.footer-cat[data-motion="on"] .footer-cat-svg {
		animation: footer-cat-bob 520ms ease-in-out infinite alternate;
	}

	.footer-cat[data-paused="true"] .footer-cat-tail-group,
	.footer-cat[data-paused="true"] .footer-cat-leg,
	.footer-cat[data-paused="true"] .footer-cat-svg {
		animation-play-state: paused;
	}

	.footer-cat-tail-group {
		transform-origin: 34px 36px;
		animation: footer-cat-tail-sway 1.1s ease-in-out infinite;
	}

	.footer-cat-leg {
		animation: footer-cat-step 420ms ease-in-out infinite alternate;
	}

	.footer-cat-leg.is-back {
		animation-delay: 210ms;
	}

	.footer-glow {
		position: absolute;
		border-radius: 999px;
		filter: blur(34px);
		pointer-events: none;
		opacity: 0.36;
	}

	.footer-glow--peach {
		left: 0.3rem;
		top: -0.6rem;
		width: 5.5rem;
		height: 5.5rem;
		background: radial-gradient(circle, rgba(255, 211, 193, 0.3), rgba(255, 211, 193, 0));
	}

	.footer-glow--mint {
		right: 0.2rem;
		bottom: -0.8rem;
		width: 6.2rem;
		height: 6.2rem;
		background: radial-gradient(circle, rgba(170, 230, 219, 0.28), rgba(170, 230, 219, 0));
	}

	.footer-main-row {
		display: flex;
		align-items: stretch;
		justify-content: space-between;
		gap: 0.9rem 1rem;
	}

	.footer-copy-block {
		flex: 0 1 auto;
		display: flex;
		align-items: center;
		align-content: center;
		flex-wrap: wrap;
		gap: 0.35rem 0.7rem;
		min-width: 0;
		min-height: 4.3rem;
	}

	.footer-brand-row {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-size: 0.76rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--deep-text) 64%, transparent);
	}

	.footer-brand {
		color: var(--primary);
		letter-spacing: 0.22em;
	}

	.footer-dot {
		width: 0.22rem;
		height: 0.22rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--deep-text) 28%, transparent);
	}

	.footer-copyline {
		margin: 0;
		font-size: 0.92rem;
		line-height: 1.45;
		color: color-mix(in srgb, var(--deep-text) 62%, transparent);
	}

	@keyframes footer-cat-bob {
		0% {
			transform: translateY(0);
		}
		100% {
			transform: translateY(-1.8px);
		}
	}

	@keyframes footer-cat-tail-sway {
		0%,
		100% {
			transform: rotate(-6deg);
		}
		50% {
			transform: rotate(7deg);
		}
	}

	@keyframes footer-cat-step {
		0% {
			transform: translateY(0);
		}
		100% {
			transform: translateY(1.8px);
		}
	}

	@media (min-width: 768px) {
		.footer-inner {
			padding: 0.8rem 0.75rem;
		}
	}

	@media (max-width: 767px) {
		.footer-divider {
			margin: 1.65rem auto 0.75rem;
		}

		.footer-card {
			width: 100%;
		}

		.footer-inner {
			padding: 0.72rem 0.1rem calc(4.2rem + env(safe-area-inset-bottom, 0px));
		}

		.footer-main-row {
			align-items: stretch;
			flex-wrap: wrap;
			gap: 0.85rem;
		}

		.footer-copy-block {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.28rem;
			min-height: auto;
		}

		.footer-brand-row {
			font-size: 0.72rem;
			letter-spacing: 0.14em;
		}

		.footer-copyline {
			font-size: 0.84rem;
			line-height: 1.52;
		}

		.footer-cat-zone {
			flex: 1 1 100%;
			min-width: 0;
			max-width: none;
			height: 3.25rem;
			margin-inline: 0;
		}

		.footer-cat {
			width: 4.2rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.footer-cat,
		.footer-cat-tail-group,
		.footer-cat-leg,
		.footer-cat-toy {
			animation: none !important;
			transition: none !important;
		}
	}

</style>

<script is:inline>
	const footerCatRuntime = (window.__themeFooterCatRuntime ??= {
		cleanup: null,
	});

	if (typeof footerCatRuntime.cleanup === "function") {
		footerCatRuntime.cleanup();
	}

	const footerCatRoot = document.currentScript?.parentElement;
	const catZone = footerCatRoot?.querySelector?.("[data-footer-cat-zone]");
	const catButton = footerCatRoot?.querySelector?.("[data-footer-cat]");
	const catToy = footerCatRoot?.querySelector?.("[data-footer-cat-toy]");

	if (
		catZone instanceof HTMLElement &&
		catButton instanceof HTMLButtonElement &&
		catToy instanceof HTMLElement
	) {
		const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
		const boundsPadding = 6;
		const roamSpeed = 34;
		const chaseSpeed = 118;

		let rafId = 0;
		let paused = false;
		let hoveringZone = false;
		let targetX = null;
		let position = 0;
		let toyX = 0;
		let direction = 1;
		let lastTimestamp = 0;

		function getMetrics() {
			const catWidth = catButton.offsetWidth || 112;
			const toyWidth = catToy.offsetWidth || 16;
			const zoneWidth = catZone.clientWidth || 0;
			return {
				catWidth,
				toyWidth,
				catMin: boundsPadding,
				catMax: Math.max(boundsPadding, zoneWidth - catWidth - boundsPadding),
				toyMin: boundsPadding,
				toyMax: Math.max(boundsPadding, zoneWidth - toyWidth - boundsPadding),
			};
		}

		function clamp(value, min, max) {
			return Math.min(max, Math.max(min, value));
		}

		function syncToy(visible) {
			catToy.dataset.visible = visible ? "true" : "false";
			catToy.style.transform = `translate3d(${toyX}px, 0, 0)`;
		}

		function syncCat() {
			catButton.style.transform = `translate3d(${position}px, 0, 0)`;
			catButton.style.setProperty("--footer-cat-dir", String(direction));
			catButton.dataset.motion = motionQuery.matches ? "off" : "on";
			catButton.dataset.paused = paused ? "true" : "false";
			catButton.setAttribute("aria-pressed", paused ? "true" : "false");
		}

		function stopLoop() {
			if (!rafId) return;
			window.cancelAnimationFrame(rafId);
			rafId = 0;
		}

		function moveTowardTarget(deltaSeconds) {
			if (targetX === null) return true;

			const distance = targetX - position;
			if (Math.abs(distance) <= 1) {
				position = targetX;
				return true;
			}

			position += Math.sign(distance) * Math.min(Math.abs(distance), chaseSpeed * deltaSeconds);
			direction = distance >= 0 ? 1 : -1;
			return false;
		}

		function animate(timestamp) {
			if (motionQuery.matches || paused) {
				stopLoop();
				return;
			}

			if (!lastTimestamp) {
				lastTimestamp = timestamp;
			}

			const deltaSeconds = Math.min((timestamp - lastTimestamp) / 1000, 0.032);
			lastTimestamp = timestamp;

			const { catMin, catMax } = getMetrics();

			if (targetX !== null) {
				targetX = clamp(targetX, catMin, catMax);
				const reached = moveTowardTarget(deltaSeconds);
				if (reached && !hoveringZone) {
					targetX = null;
				}
			} else {
				position += direction * roamSpeed * deltaSeconds;

				if (position <= catMin) {
					position = catMin;
					direction = 1;
				} else if (position >= catMax) {
					position = catMax;
					direction = -1;
				}
			}

			syncCat();
			rafId = window.requestAnimationFrame(animate);
		}

		function startLoop() {
			if (motionQuery.matches || paused) {
				stopLoop();
				return;
			}

			if (rafId) return;
			lastTimestamp = 0;
			rafId = window.requestAnimationFrame(animate);
		}

		function setInitialPosition() {
			const { catMin, catMax, toyMin, toyMax } = getMetrics();
			position = clamp(catMax * 0.28, catMin, catMax);
			toyX = clamp(position + 34, toyMin, toyMax);
			targetX = null;
			syncCat();
			syncToy(false);
		}

		function setTargetFromClientX(clientX) {
			const rect = catZone.getBoundingClientRect();
			const { catWidth, toyWidth, catMin, catMax, toyMin, toyMax } = getMetrics();
			toyX = clamp(clientX - rect.left - toyWidth / 2, toyMin, toyMax);
			targetX = clamp(clientX - rect.left - catWidth / 2, catMin, catMax);
			direction = targetX >= position ? 1 : -1;
			syncToy(true);
			syncCat();
		}

		function handlePointerMove(event) {
			hoveringZone = true;
			setTargetFromClientX(event.clientX);

			if (motionQuery.matches) {
				position = targetX ?? position;
				syncCat();
				return;
			}

			if (!paused) {
				startLoop();
			}
		}

		function handlePointerLeave() {
			hoveringZone = false;
			targetX = null;
			syncToy(false);
		}

		function handleZoneClick(event) {
			if (event.target === catButton || catButton.contains(event.target)) return;

			if (paused) {
				paused = false;
			}

			setTargetFromClientX(event.clientX);

			if (motionQuery.matches) {
				position = targetX ?? position;
				syncCat();
				return;
			}

			startLoop();
		}

		function handleCatClick(event) {
			event.preventDefault();
			paused = !paused;

			if (paused) {
				targetX = null;
				hoveringZone = false;
				syncToy(false);
				stopLoop();
			} else {
				startLoop();
			}

			syncCat();
		}

		function handleMotionChange() {
			catButton.dataset.motion = motionQuery.matches ? "off" : "on";

			if (motionQuery.matches) {
				stopLoop();
				targetX = null;
				syncToy(false);
				syncCat();
				return;
			}

			if (!paused) {
				startLoop();
			}
		}

		function handleResize() {
			const { catMin, catMax, toyMin, toyMax } = getMetrics();
			position = clamp(position, catMin, catMax);
			toyX = clamp(toyX, toyMin, toyMax);
			if (targetX !== null) {
				targetX = clamp(targetX, catMin, catMax);
			}
			syncCat();
			syncToy(catToy.dataset.visible === "true");
		}

		setInitialPosition();
		handleMotionChange();

		catZone.addEventListener("pointermove", handlePointerMove);
		catZone.addEventListener("pointerleave", handlePointerLeave);
		catZone.addEventListener("click", handleZoneClick);
		catButton.addEventListener("click", handleCatClick);
		window.addEventListener("resize", handleResize);

		motionQuery.addEventListener("change", handleMotionChange);

		footerCatRuntime.cleanup = () => {
			stopLoop();
			catZone.removeEventListener("pointermove", handlePointerMove);
			catZone.removeEventListener("pointerleave", handlePointerLeave);
			catZone.removeEventListener("click", handleZoneClick);
			catButton.removeEventListener("click", handleCatClick);
			window.removeEventListener("resize", handleResize);

			motionQuery.removeEventListener("change", handleMotionChange);
		};
	} else {
		footerCatRuntime.cleanup = null;
	}
</script>
