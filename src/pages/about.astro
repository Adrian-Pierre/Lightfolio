				y: 0,
				targetX: 0,
				targetY: 0,
				influence: 0,
				targetInfluence: 0,
			};
			const pulses: Array<{ x: number; y: number; startedAt: number }> = [];

			const resize = () => {
				const rect = stage.getBoundingClientRect();
				width = Math.max(rect.width, 1);
				height = Math.max(rect.height, 1);
				dpr = Math.min(window.devicePixelRatio || 1, 2);
				canvas.width = Math.round(width * dpr);
				canvas.height = Math.round(height * dpr);
				canvas.style.width = `${width}px`;
				canvas.style.height = `${height}px`;

				if (pointer.targetX === 0 && pointer.targetY === 0) {
					pointer.x = width * 0.52;
					pointer.y = height * 0.52;
					pointer.targetX = pointer.x;
					pointer.targetY = pointer.y;
				}
			};

			const updatePointer = (event: PointerEvent) => {
				const rect = stage.getBoundingClientRect();
				pointer.targetX = event.clientX - rect.left;
				pointer.targetY = event.clientY - rect.top;
				pointer.targetInfluence = 1;
				stage.dataset.active = "true";
			};

			const releasePointer = () => {
				pointer.targetInfluence = 0;
				stage.dataset.active = "false";
			};

			const pushPulse = (x: number, y: number, startedAt = performance.now()) => {
				pulses.push({ x, y, startedAt });
				if (pulses.length > 4) {
					pulses.shift();
				}
			};

			const addPulse = (event: PointerEvent) => {
				updatePointer(event);
				pushPulse(pointer.targetX, pointer.targetY);
