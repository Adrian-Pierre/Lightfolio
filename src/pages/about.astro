				}
			};

			const handlePointerEnd = (event: PointerEvent) => {
				if (event.pointerType !== "mouse") {
					releasePointer();
				}
			};

			const toneColor = (tone: OrbitNodeSeed["tone"], alpha: number) => {
				if (tone === "accent") return this.colorFromRgb(accent, alpha);
				if (tone === "rose") return `rgba(255, 214, 228, ${alpha})`;
				return `rgba(194, 225, 255, ${alpha})`;
			};

			const drawOrbitRing = (
				now: number,
				centerX: number,
				centerY: number,
				radiusX: number,
				radiusY: number,
				rotation: number,
				lineAlpha: number,
				lineWidth: number,
				dashOffset: number,
			) => {
				context.save();
				context.translate(centerX, centerY);
				context.rotate(rotation);
				context.beginPath();
				context.setLineDash([7, 11]);
				context.lineDashOffset = dashOffset - now * 0.012;
				context.ellipse(0, 0, radiusX, radiusY, 0, 0, Math.PI * 2);
				context.lineWidth = lineWidth;
				context.strokeStyle = this.colorFromRgb(accent, lineAlpha);
				context.stroke();
				context.restore();
				context.setLineDash([]);
			};

			const render = (now: number) => {
				animationFrame = window.requestAnimationFrame(render);
				if (!width || !height) return;

				frameCount += 1;
				if (frameCount % 18 === 0) {
					accent = this.readAccentRgb();
				}

				const motionEnabled = this.dataset.motion !== "off" && !reducedMotionQuery.matches;
				const easing = motionEnabled ? 0.18 : 0.1;
				pointer.x += (pointer.targetX - pointer.x) * easing;
				pointer.y += (pointer.targetY - pointer.y) * easing;
				pointer.influence += (pointer.targetInfluence - pointer.influence) * (motionEnabled ? 0.14 : 0.18);

				context.setTransform(dpr, 0, 0, dpr, 0, 0);
				context.clearRect(0, 0, width, height);

				const minSide = Math.min(width, height);
				const driftScale = motionEnabled ? 1 : 0.42;
				const focusX = width * 0.52 + Math.sin(now * 0.00024) * width * 0.024 * driftScale;
				const focusY = height * 0.5 + Math.cos(now * 0.00018) * height * 0.024 * driftScale;
				const lensX = focusX + (pointer.x - focusX) * pointer.influence * 0.36;
				const lensY = focusY + (pointer.y - focusY) * pointer.influence * 0.36;

				const halo = context.createRadialGradient(lensX, lensY, 0, lensX, lensY, minSide * 0.72);
				halo.addColorStop(0, this.colorFromRgb(accent, 0.26 + pointer.influence * 0.16));
				halo.addColorStop(0.3, "rgba(255, 214, 228, 0.11)");
				halo.addColorStop(1, "rgba(255, 255, 255, 0)");
				context.fillStyle = halo;
				context.fillRect(0, 0, width, height);

				drawOrbitRing(now, focusX, focusY, width * 0.24, height * 0.16, now * 0.00018, 0.24 + pointer.influence * 0.08, 1.25, 0);
				drawOrbitRing(now, focusX, focusY, width * 0.34, height * 0.24, -0.92 + now * 0.00012, 0.16 + pointer.influence * 0.05, 1.05, -32);
				drawOrbitRing(now, focusX, focusY, width * 0.17, height * 0.12, 0.48 - now * 0.00016, 0.2 + pointer.influence * 0.05, 1, -12);

				const nodes = seeds.map((seed) => {
					const x =
						seed.x * width +
						Math.sin(now * seed.speed + seed.phase) * seed.driftX * width * driftScale;
					const y =
						seed.y * height +
						Math.cos(now * seed.speed * 1.12 + seed.phase) * seed.driftY * height * driftScale;
					const dx = pointer.x - x;
					const dy = pointer.y - y;
					const distance = Math.hypot(dx, dy);
					const influenceRadius = minSide * 0.64;
					const influence =
						motionEnabled && pointer.influence > 0.02
							? Math.max(0, 1 - distance / influenceRadius) * pointer.influence
							: 0;

					return {
						x: x + dx * influence * 0.22,
						y: y + dy * influence * 0.22,
						size: seed.size + influence * 3.1,
						tone: seed.tone,
						influence,
					};
				});

				for (let index = 0; index < nodes.length; index += 1) {
					for (let next = index + 1; next < nodes.length; next += 1) {
						const nodeA = nodes[index];
						const nodeB = nodes[next];
						const dx = nodeA.x - nodeB.x;
						const dy = nodeA.y - nodeB.y;
						const distance = Math.hypot(dx, dy);
						const maxDistance = minSide * 0.42;
						if (distance > maxDistance) continue;

						const strength = (1 - distance / maxDistance) ** 1.7;
						context.beginPath();
						context.moveTo(nodeA.x, nodeA.y);
						context.lineTo(nodeB.x, nodeB.y);
						context.lineWidth = 1 + strength * 0.9;
						context.strokeStyle = this.colorFromRgb(accent, 0.08 + strength * 0.24 + pointer.influence * 0.06);
						context.stroke();
					}
				}

				for (let index = pulses.length - 1; index >= 0; index -= 1) {
					const pulse = pulses[index];
					const elapsed = now - pulse.startedAt;
					if (elapsed > 780) {
						pulses.splice(index, 1);
						continue;
					}

					const progress = elapsed / 780;
					context.beginPath();
					context.arc(pulse.x, pulse.y, 18 + progress * minSide * 0.28, 0, Math.PI * 2);
					context.lineWidth = 1.4 - progress * 0.76;
					context.strokeStyle = this.colorFromRgb(accent, 0.34 * (1 - progress));
					context.stroke();
				}

				context.beginPath();
				context.arc(focusX, focusY, minSide * 0.052, 0, Math.PI * 2);
				context.fillStyle = this.colorFromRgb(accent, 0.24 + pointer.influence * 0.08);
				context.fill();

				for (const node of nodes) {
					context.beginPath();
					context.arc(node.x, node.y, node.size * 2.2, 0, Math.PI * 2);
					context.fillStyle = toneColor(node.tone, 0.1 + node.influence * 0.12);
					context.fill();

					context.beginPath();
					context.arc(node.x, node.y, node.size, 0, Math.PI * 2);
					context.fillStyle = toneColor(node.tone, 0.88);
					context.shadowColor = toneColor(node.tone, 0.52);
					context.shadowBlur = 18;
					context.fill();
					context.shadowBlur = 0;
				}
			};

			const start = () => {
				if (animationFrame !== 0) return;
				animationFrame = window.requestAnimationFrame(render);
			};

			const stop = () => {
				if (animationFrame === 0) return;
				window.cancelAnimationFrame(animationFrame);
				animationFrame = 0;
			};

			const handleVisibility = () => {
				if (document.hidden) {
					stop();
					return;
				}
				start();
			};

			const resizeObserver = new ResizeObserver(resize);
			resizeObserver.observe(stage);
			resize();
			start();

			stage.addEventListener("pointermove", updatePointer);
			stage.addEventListener("pointerenter", handlePointerEnter);
			stage.addEventListener("pointerleave", releasePointer);
			stage.addEventListener("pointerdown", addPulse);
			stage.addEventListener("pointerup", handlePointerEnd);
			stage.addEventListener("pointercancel", releasePointer);
			document.addEventListener("visibilitychange", handleVisibility);

			this.cleanupFns.push(() => {
				stop();
				resizeObserver.disconnect();
				stage.removeEventListener("pointermove", updatePointer);
				stage.removeEventListener("pointerenter", handlePointerEnter);
				stage.removeEventListener("pointerleave", releasePointer);
				stage.removeEventListener("pointerdown", addPulse);
				stage.removeEventListener("pointerup", handlePointerEnd);
				stage.removeEventListener("pointercancel", releasePointer);
				document.removeEventListener("visibilitychange", handleVisibility);
			});
		}

		private readAccentRgb() {
			const value = getComputedStyle(this).getPropertyValue("--about-active-rgb").trim();
			return value || "170 230 219";
		}

		private colorFromRgb(rgb: string, alpha: number) {
			const [red = 170, green = 230, blue = 219] = rgb
				.split(/\s+/)
				.map((value) => Number.parseFloat(value))
				.filter((value) => Number.isFinite(value));
			return `rgba(${red}, ${green}, ${blue}, ${alpha})`;
		}

	}

	if (!customElements.get("about-interactive")) {
		customElements.define("about-interactive", AboutInteractive);
	}
</script>
