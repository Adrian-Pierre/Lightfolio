---
import { getEntry, render } from "astro:content";
import ImageWrapper from "@components/misc/ImageWrapper.astro";
import Markdown from "@components/misc/Markdown.astro";
import { Icon } from "astro-icon/components";
import { profileConfig } from "../config";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import {
	getCategoryList,
	getSortedPosts,
	getTagList,
} from "../utils/content-utils";
import { formatDateToYYYYMMDD } from "../utils/date-utils";
import { url } from "../utils/url-utils";

const aboutPost = await getEntry("spec", "about");

if (!aboutPost) {
	throw new Error("About page content not found");
}

const { Content } = await render(aboutPost);
const hasAboutBody =
	typeof aboutPost.body === "string" && aboutPost.body.trim().length > 0;
const [sortedPosts, tagList, categoryList] = await Promise.all([
	getSortedPosts(),
	getTagList(),
	getCategoryList(),
]);
const latestPosts = sortedPosts.slice(0, 3);
const activityDates = sortedPosts.map(
	(post) => post.data.updated ?? post.data.published,
);
const latestActivityDate =
	activityDates.length > 0
		? activityDates.reduce((latest, current) =>
				current > latest ? current : latest,
			)
		: undefined;
const latestActivityLabel = latestActivityDate
	? formatDateToYYYYMMDD(latestActivityDate)
	: "--";
const siteSnapshot = [
	{
		labelZh: "文章",
		labelEn: "Posts",
		value: String(sortedPosts.length),
	},
	{
		labelZh: "标签",
		labelEn: "Tags",
		value: String(tagList.length),
	},
	{
		labelZh: "分类",
		labelEn: "Categories",
		value: String(categoryList.length),
	},
	{
		labelZh: "最近更新",
		labelEn: "Last update",
		value: latestActivityLabel,
	},
];

const quickLinks = [
	{
		titleZh: "归档",
		titleEn: "Archive",
		href: url("/archive/"),
		icon: "material-symbols:library-books-outline-rounded",
	},
	{
		titleZh: "相册",
		titleEn: "Gallery",
		href: url("/pictures/"),
		icon: "material-symbols:imagesmode-outline-rounded",
	},
	{
		titleZh: "友链",
		titleEn: "Friends",
		href: url("/friends/"),
		icon: "material-symbols:handshake-outline-rounded",
	},
];

const DEFAULT_ABOUT_ACCENT = "170 230 219";
const aboutDisplayName = profileConfig.name.replace(/\s+/g, " ").trim();
const featuredProject = {
	owner: "Adrian-Pierre",
	repo: "Lightfolio",
	href: "https://github.com/Adrian-Pierre/Lightfolio",
	descriptionZh:
		"一个基于 Astro 和 Fuwari 定制开发的开源博客主题，包含独立页面、扩展 Markdown 与响应式布局。",
	descriptionEn:
		"An open-source blog theme built with Astro and Fuwari, featuring custom pages, extended Markdown, and responsive layouts.",
	meta: ["Astro", "Fuwari"],
};
---
<MainGridLayout title="关于" description="关于" hideSidebar={true}>
	<about-interactive class="about-page" style={`--about-active-rgb:${DEFAULT_ABOUT_ACCENT};`}>
		<div
			hidden
			data-lang-document-title-zh={`关于 - ${profileConfig.name}`}
			data-lang-document-title-en={`About - ${profileConfig.name}`}
		></div>
		<section class="about-hero card-base relative overflow-hidden px-6 py-6 md:px-8 md:py-8" data-tilt-surface>
			<div class="about-orb is-pink"></div>
			<div class="about-orb is-mint"></div>
			<div class="about-orb is-blue"></div>

				<div class="about-hero-grid relative z-10">
					<div class="about-portrait-wrap">
						<div class="about-portrait-glow"></div>
						<div class="about-portrait-shell">
						<ImageWrapper
							src={profileConfig.avatar || ""}
							alt={`${profileConfig.name} avatar`}
							class="h-full w-full"
							fit="cover"
								overlay={false}
							/>
						</div>
					</div>

					<div class="about-copy">
						<div class="about-copy-main">
							<p class="about-kicker" data-lang-zh="关于" data-lang-en="About">About</p>
							<h1 class="about-name">{aboutDisplayName}</h1>
							<p class="about-bio">{profileConfig.bio || "A small corner for notes and feelings."}</p>
							<p
								class="about-lead"
								data-lang-zh="这里可以介绍你自己、你的创作方向，以及这个博客所记录的内容。"
								data-lang-en="Introduce yourself, your work, and the ideas collected on this blog."
							>
								Introduce yourself, your work, and the ideas collected on this blog.
							</p>

							{profileConfig.links.length > 0 && (
								<div class="about-socials about-socials--intro">
									{profileConfig.links.map((item) => (
										<a
											rel="me"
											aria-label={item.name}
											href={item.url}
											target="_blank"
											class="about-social-link"
										>
											<Icon name={item.icon} class="text-[1.15rem]" />
											<span>{item.name}</span>
										</a>
									))}
								</div>
							)}
						</div>

						<aside class="about-copy-side">
							<section class="about-hero-panel">
								<section class="about-widget-card about-widget-card--hero about-orbit-card">
									<div
										class="about-orbit-stage"
										data-about-orbit-stage
										data-active="false"
										aria-label="Interactive orbit field"
									>
										<div class="about-orbit-glow is-one"></div>
										<div class="about-orbit-glow is-two"></div>
										<canvas class="about-orbit-canvas" data-about-orbit-canvas></canvas>
									</div>
								</section>
							</section>
						</aside>
					</div>
				</div>
			</section>

		<div class="about-lower-grid">
			<section class="card-base about-content-panel relative overflow-hidden px-6 py-6 md:px-7 md:py-7" data-tilt-surface>
				<div class="about-panel-glow is-content"></div>
				<div class="about-content-shell relative z-10">
					<div class="about-section-head">
						<span class="about-section-dot"></span>
						<h2 data-lang-zh="这个小站" data-lang-en="This Corner">This Corner</h2>
					</div>

					<a
						href={featuredProject.href}
						target="_blank"
						rel="noreferrer"
						class="about-project-card"
					>
						<div class="about-project-titlebar">
							<div class="about-project-titlegroup">
								<div class="about-project-avatar">
									<ImageWrapper
										src={profileConfig.avatar || ""}
										alt={`${featuredProject.owner} avatar`}
										class="h-full w-full"
										fit="cover"
										overlay={false}
									/>
								</div>
								<div class="about-project-heading">
									<p>{featuredProject.owner}</p>
									<h3>{featuredProject.repo}</h3>
								</div>
							</div>

							<div class="about-project-github">
								<Icon name="fa6-brands:github" class="text-[1.7rem]" />
							</div>
						</div>

						<p
							class="about-project-description"
							data-lang-zh={featuredProject.descriptionZh}
							data-lang-en={featuredProject.descriptionEn}
						>
							{featuredProject.descriptionEn}
						</p>

						<div class="about-project-meta">
							{featuredProject.meta.map((item) => (
								<span class="about-project-pill">{item}</span>
							))}
						</div>
					</a>

					<div class="about-content-bottom">
						<div class="about-content-snapshot">
							<div class="about-side-subhead">
								<p data-lang-zh="站点概览" data-lang-en="Site Snapshot">Site Snapshot</p>
							</div>

							<p
								class="about-side-intro"
								data-lang-zh="先把这个小站的体量和更新节奏放在左边，读完这里再继续往下看会更顺手。"
								data-lang-en="A quick snapshot of this site lives here first, so the rest of the page feels easier to scan."
							>
								A quick snapshot of this site lives here first, so the rest of the page feels easier to scan.
							</p>

							<div class="about-insight-grid">
								{siteSnapshot.map((item) => (
									<article class="about-insight-card">
										<span class="about-insight-label" data-lang-zh={item.labelZh} data-lang-en={item.labelEn}>
											{item.labelEn}
										</span>
										<strong class="about-insight-value">{item.value}</strong>
									</article>
								))}
							</div>
						</div>

						{hasAboutBody && (
							<Markdown class="about-markdown about-markdown-compact mt-5">
								<Content />
							</Markdown>
						)}
					</div>
				</div>
			</section>

			<aside class="about-side-grid">
				<section class="card-base about-side-card relative overflow-hidden px-6 py-6 md:px-7 md:py-7" data-tilt-surface>
					<div class="about-panel-glow is-links"></div>
					<div class="about-side-shell relative z-10">
						<div class="about-section-head">
							<span class="about-section-dot"></span>
							<h2 data-lang-zh="继续逛逛" data-lang-en="Explore">Explore</h2>
						</div>

						<p
							class="about-side-intro"
							data-lang-zh="右边留给最近更新和常用入口，想继续逛的时候会更直接。"
							data-lang-en="Recent updates and quick routes stay on the right, so continuing to browse feels direct."
						>
							Recent updates and quick routes stay on the right, so continuing to browse feels direct.
						</p>

						<div class="about-side-block">
							<div class="about-side-subhead">
								<p data-lang-zh="最新文章" data-lang-en="Latest Posts">Latest Posts</p>
								<span class="about-side-note">{latestPosts.length}</span>
							</div>

							{latestPosts.length > 0 ? (
								<div class="about-recent-list">
									{latestPosts.map((post, index) => (
										<a href={url(`/posts/${post.slug}/`)} class="about-recent-item">
											<span class="about-recent-index">{String(index + 1).padStart(2, "0")}</span>
											<div class="about-recent-copy">
												<h3>{post.data.title}</h3>
												<p>{formatDateToYYYYMMDD(post.data.published)}</p>
											</div>
											<Icon name="material-symbols:arrow-outward-rounded" class="about-recent-arrow" />
										</a>
									))}
								</div>
							) : (
								<p
									class="about-recent-empty"
									data-lang-zh="这里还没有文章，之后再来看看。"
									data-lang-en="No posts here yet. Check back again soon."
								>
									No posts here yet. Check back again soon.
								</p>
							)}
						</div>

						<div class="about-side-block">
							<div class="about-side-subhead">
								<p data-lang-zh="常用入口" data-lang-en="Shortcuts">Shortcuts</p>
							</div>

							<div class="about-shortcut-row">
								{quickLinks.map((item) => (
									<a href={item.href} class="about-shortcut-chip">
										<Icon name={item.icon} class="text-[1.05rem]" />
										<span data-lang-zh={item.titleZh} data-lang-en={item.titleEn}>{item.titleEn}</span>
									</a>
								))}
							</div>
						</div>

					</div>
				</section>
			</aside>
		</div>
	</about-interactive>
</MainGridLayout>

<style>
	about-interactive {
		display: block;
	}

	.about-page {
		display: grid;
		gap: 1.6rem;
	}

	about-interactive[data-motion="off"] .about-hero,
	about-interactive[data-motion="off"] .about-content-panel,
	about-interactive[data-motion="off"] .about-side-card {
		transform: none !important;
	}

	about-interactive[data-motion="off"] .about-hero::after,
	about-interactive[data-motion="off"] .about-content-panel::after,
	about-interactive[data-motion="off"] .about-side-card::after {
		opacity: 0 !important;
	}

	.about-hero,
	.about-content-panel,
	.about-side-card {
		position: relative;
		isolation: isolate;
		transform:
			perspective(1600px)
			rotateX(var(--about-tilt-x, 0deg))
			rotateY(var(--about-tilt-y, 0deg));
		transform-style: preserve-3d;
		will-change: transform;
		transition:
			transform 260ms cubic-bezier(0.22, 1, 0.36, 1),
			box-shadow 260ms ease;
	}

	.about-hero::after,
	.about-content-panel::after,
	.about-side-card::after {
		content: "";
		position: absolute;
		inset: -35%;
		background:
			radial-gradient(
				circle at var(--about-pointer-x, 50%) var(--about-pointer-y, 50%),
				rgba(var(--about-active-rgb, 170 230 219), 0.18),
				rgba(255, 255, 255, 0) 24rem
			);
		opacity: var(--about-surface-glow, 0);
		pointer-events: none;
		transition: opacity 220ms ease;
		z-index: 0;
	}

	.about-hero[data-hovered="true"],
	.about-content-panel[data-hovered="true"],
	.about-side-card[data-hovered="true"] {
		--about-surface-glow: 1;
		box-shadow: 0 34px 78px -48px rgba(24, 51, 56, 0.28);
	}

	.about-hero {
		background:
			radial-gradient(circle at 78% 18%, rgba(var(--about-active-rgb, 170 230 219), 0.28), transparent 16rem),
			linear-gradient(140deg, rgba(255, 255, 255, 0.9), rgba(251, 245, 255, 0.82) 34%, rgba(241, 252, 248, 0.82) 68%, rgba(239, 247, 255, 0.88)),
			rgba(255, 255, 255, 0.72);
		box-shadow: 0 36px 76px -50px rgba(24, 51, 56, 0.28);
	}

	.about-hero-grid {
		display: grid;
		gap: 2rem;
		align-items: start;
		grid-template-columns: minmax(0, 15.75rem) minmax(0, 1fr);
	}

	.about-orb {
		position: absolute;
		border-radius: 999px;
		filter: blur(10px);
		opacity: 0.8;
		pointer-events: none;
	}

	.about-orb.is-pink {
		top: -2.5rem;
		left: -1rem;
		width: 12rem;
		height: 12rem;
		background: radial-gradient(circle, rgba(255, 207, 223, 0.75), rgba(255, 207, 223, 0));
	}

	.about-orb.is-mint {
		right: 10%;
		top: 2rem;
		width: 10rem;
		height: 10rem;
		background: radial-gradient(circle, rgba(179, 237, 226, 0.68), rgba(179, 237, 226, 0));
	}

	.about-orb.is-blue {
		right: -1.5rem;
		bottom: -2rem;
		width: 12rem;
		height: 12rem;
		background: radial-gradient(circle, rgba(198, 227, 255, 0.75), rgba(198, 227, 255, 0));
	}

	.about-portrait-wrap {
		position: relative;
		padding-top: 0.35rem;
		padding-bottom: 0.8rem;
	}

	.about-portrait-glow {
		position: absolute;
		inset: 1.2rem;
		border-radius: 2rem;
		background: linear-gradient(145deg, rgba(255, 214, 228, 0.58), rgba(183, 230, 221, 0.42));
		filter: blur(16px);
		opacity: 0.9;
	}

	.about-portrait-shell {
		position: relative;
		overflow: hidden;
		aspect-ratio: 1 / 1.12;
		border-radius: 1.85rem;
		padding: 0.68rem;
		border: 1px solid rgba(255, 255, 255, 0.92);
		background:
			linear-gradient(160deg, rgba(255, 255, 255, 0.72), rgba(255, 255, 255, 0.28)),
			linear-gradient(135deg, rgba(255, 211, 223, 0.4), rgba(194, 230, 255, 0.32));
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.9),
			0 28px 56px -42px rgba(24, 51, 56, 0.34);
		backdrop-filter: blur(18px);
		-webkit-backdrop-filter: blur(18px);
	}

	.about-portrait-shell :global(img) {
		border-radius: 1.3rem;
	}

	.about-copy {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(16.5rem, 18.8rem);
		gap: 1.35rem;
		align-items: start;
	}

	.about-copy-main {
		min-width: 0;
		padding-top: 0.25rem;
	}

	.about-copy-side {
		min-width: 0;
	}

	.about-hero-panel {
		display: grid;
		gap: 0;
		padding: 0;
		border: none;
		border-radius: 0;
		background: transparent;
		box-shadow: none;
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
	}

	.about-chip-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
	}

	.about-chip-row.is-panel {
		margin-top: 0.1rem;
	}

	.about-chip {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.42rem 0.8rem;
		border-radius: 999px;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		border: 1px solid rgba(255, 255, 255, 0.72);
		box-shadow: 0 14px 28px -22px rgba(24, 51, 56, 0.16);
	}

	.about-chip.is-mint {
		background: rgba(221, 247, 240, 0.88);
		color: #4e857e;
	}

	.about-chip.is-peach {
		background: rgba(255, 233, 223, 0.9);
		color: #a86f5e;
	}

	.about-chip.is-blue {
		background: rgba(225, 239, 255, 0.9);
		color: #5c7d9b;
	}

	.about-kicker {
		margin: 0;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		color: rgba(82, 103, 114, 0.82);
	}

	.about-name {
		margin: 0.75rem 0 0;
		font-size: clamp(2.8rem, 4.8vw, 4.15rem);
		line-height: 0.96;
		font-weight: 900;
		letter-spacing: 0.03em;
		color: rgb(73 85 93);
		text-wrap: balance;
		text-shadow:
			0 1px 0 rgba(255, 255, 255, 0.84),
			0 12px 24px rgba(177, 197, 223, 0.08);
		-webkit-text-stroke: 0.01em rgba(73, 85, 93, 0.02);
	}

	.about-bio {
		display: inline-flex;
		align-items: center;
		margin: 1rem 0 0;
		padding: 0.36rem 0.7rem;
		border-radius: 999px;
		border: 1px solid rgba(255, 255, 255, 0.78);
		background: rgba(255, 255, 255, 0.52);
		font-size: 0.78rem;
		line-height: 1;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: rgba(73, 93, 100, 0.78);
		box-shadow: 0 14px 28px -24px rgba(24, 51, 56, 0.18);
	}

	.about-lead {
		margin: 1.15rem 0 0;
		max-width: 34rem;
		font-size: 1rem;
		line-height: 1.9;
		color: rgba(51, 79, 82, 0.68);
	}

	.about-socials {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 0;
	}

	.about-socials--intro {
		margin-top: 1.2rem;
	}

	.about-socials.is-panel {
		display: grid;
		gap: 0.65rem;
		margin-top: 0.45rem;
		margin-bottom: 0.3rem;
	}

	.about-social-link {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.75rem 1rem;
		border-radius: 1rem;
		border: 1px solid rgba(255, 255, 255, 0.84);
		background: rgba(255, 255, 255, 0.68);
		color: var(--deep-text);
		font-size: 0.95rem;
		font-weight: 600;
		box-shadow: 0 18px 40px -32px rgba(24, 51, 56, 0.24);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		transition:
			transform 0.22s ease,
			background-color 0.22s ease,
			border-color 0.22s ease,
			box-shadow 0.22s ease;
	}

	.about-socials.is-panel .about-social-link {
		width: 100%;
		justify-content: center;
		padding: 0.72rem 0.95rem;
		border-radius: 1rem;
	}

	.about-social-link:hover {
		transform: translateY(-2px);
		background: rgba(255, 255, 255, 0.88);
		box-shadow: 0 24px 48px -34px rgba(24, 51, 56, 0.28);
	}

	.about-widget-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.9rem;
		margin-top: 1.5rem;
	}

	.about-widget-grid.is-compact {
		grid-template-columns: minmax(0, 1fr);
		max-width: 17rem;
	}

	.about-widget-card {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		min-height: 9rem;
		padding: 1rem 1.05rem;
		border-radius: 1.25rem;
		border: 1px solid rgba(255, 255, 255, 0.84);
		background:
			linear-gradient(145deg, rgba(var(--about-active-rgb, 170 230 219), 0.16), rgba(255, 255, 255, 0.26) 52%, rgba(255, 255, 255, 0) 100%),
			linear-gradient(160deg, rgba(255, 255, 255, 0.72), rgba(255, 255, 255, 0.42)),
			rgba(255, 255, 255, 0.5);
		box-shadow: 0 24px 48px -38px rgba(24, 51, 56, 0.24);
	}

	.about-widget-card--hero {
		min-height: auto;
		padding: 0.72rem;
		border-radius: 1.2rem;
		border: 1px solid rgba(var(--about-active-rgb, 170 230 219), 0.22);
		background:
			linear-gradient(145deg, rgba(var(--about-active-rgb, 170 230 219), 0.12), rgba(255, 255, 255, 0.18) 52%, rgba(255, 255, 255, 0) 100%),
			linear-gradient(160deg, rgba(255, 255, 255, 0.72), rgba(255, 255, 255, 0.4)),
			rgba(255, 255, 255, 0.46);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.9),
			0 22px 42px -32px rgba(24, 51, 56, 0.24),
			0 0 0 1px rgba(var(--about-active-rgb, 170 230 219), 0.08);
	}

	.about-widget-card--hero.about-orbit-card {
