<script>
	class AboutInteractive extends HTMLElement {
		private cleanupFns: Array<() => void> = [];

		connectedCallback() {
			this.dataset.motion = "on";
			this.setupOrbitField();

			if (!window.matchMedia("(pointer: fine)").matches) {
				return;
			}

			this.setupTiltSurfaces();
		}

		disconnectedCallback() {
			this.cleanupFns.forEach((cleanup) => cleanup());
			this.cleanupFns = [];
		}

		private setupTiltSurfaces() {
			const surfaces = Array.from(this.querySelectorAll<HTMLElement>("[data-tilt-surface]"));

			for (const surface of surfaces) {
				const onMove = (event: PointerEvent) => {
					if (this.dataset.motion === "off") return;

					const rect = surface.getBoundingClientRect();
					const x = ((event.clientX - rect.left) / rect.width) * 100;
					const y = ((event.clientY - rect.top) / rect.height) * 100;
					const rotateY = ((x - 50) / 50) * 2.4;
					const rotateX = ((50 - y) / 50) * 2.1;

					surface.style.setProperty("--about-pointer-x", `${x}%`);
					surface.style.setProperty("--about-pointer-y", `${y}%`);
					surface.style.setProperty("--about-tilt-x", `${rotateX}deg`);
					surface.style.setProperty("--about-tilt-y", `${rotateY}deg`);
					surface.dataset.hovered = "true";
				};

				const reset = () => {
					surface.style.setProperty("--about-tilt-x", "0deg");
					surface.style.setProperty("--about-tilt-y", "0deg");
					surface.dataset.hovered = "false";
				};

				surface.addEventListener("pointermove", onMove);
				surface.addEventListener("pointerleave", reset);

				this.cleanupFns.push(() => {
					surface.removeEventListener("pointermove", onMove);
					surface.removeEventListener("pointerleave", reset);
				});
			}
		}

		private setupOrbitField() {
			const stage = this.querySelector<HTMLElement>("[data-about-orbit-stage]");
			const canvas = this.querySelector<HTMLCanvasElement>("[data-about-orbit-canvas]");
			if (!stage || !canvas) return;

			const context = canvas.getContext("2d");
			if (!context) return;

			type OrbitNodeSeed = {
				x: number;
				y: number;
				driftX: number;
				driftY: number;
				speed: number;
				phase: number;
				size: number;
				tone: "accent" | "rose" | "sky";
			};

			const seeds: OrbitNodeSeed[] = [
				{ x: 0.18, y: 0.22, driftX: 0.028, driftY: 0.038, speed: 0.0007, phase: 0.3, size: 3.6, tone: "rose" },
				{ x: 0.34, y: 0.3, driftX: 0.025, driftY: 0.03, speed: 0.00092, phase: 1.2, size: 4.2, tone: "accent" },
				{ x: 0.58, y: 0.18, driftX: 0.032, driftY: 0.028, speed: 0.00078, phase: 2.1, size: 3.5, tone: "sky" },
				{ x: 0.78, y: 0.26, driftX: 0.026, driftY: 0.034, speed: 0.00082, phase: 3.1, size: 4.1, tone: "accent" },
				{ x: 0.22, y: 0.58, driftX: 0.024, driftY: 0.03, speed: 0.00088, phase: 4.2, size: 3.4, tone: "sky" },
				{ x: 0.46, y: 0.52, driftX: 0.03, driftY: 0.026, speed: 0.00095, phase: 5, size: 5.2, tone: "accent" },
				{ x: 0.7, y: 0.56, driftX: 0.024, driftY: 0.036, speed: 0.00074, phase: 5.8, size: 3.9, tone: "rose" },
				{ x: 0.84, y: 0.68, driftX: 0.02, driftY: 0.024, speed: 0.00068, phase: 0.8, size: 3.2, tone: "sky" },
				{ x: 0.4, y: 0.8, driftX: 0.03, driftY: 0.02, speed: 0.00072, phase: 2.8, size: 3.7, tone: "rose" },
				{ x: 0.62, y: 0.78, driftX: 0.022, driftY: 0.028, speed: 0.00084, phase: 1.7, size: 4.4, tone: "accent" },
			];

			let width = 0;
			let height = 0;
			let dpr = 1;
			let animationFrame = 0;
			let accent = this.readAccentRgb();
			let frameCount = 0;

			const reducedMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
			const pointer = {
